          <mxGeometry x="50" y="770" width="630" height="280" as="geometry" />
        </mxCell>

        <mxCell id="legend_ports" value="&lt;b&gt;&lt;font color='#38BDF8' style='font-size: 13px;'&gt;Port Matrix &amp; Network Mapping&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;table style='font-size: 11px; color: #CBD5E1; border-collapse: collapse; width: 100%;'&gt;&lt;tr style='border-bottom: 1px solid #334155;'&gt;&lt;td&gt;&lt;b&gt;Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Service&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Scope&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color='#38BDF8'&gt;443&lt;/font&gt;&lt;/td&gt;&lt;td&gt;HTTPS Public Web&lt;/td&gt;&lt;td&gt;Global Internet&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color='#38BDF8'&gt;8085&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Nginx Web Gateway&lt;/td&gt;&lt;td&gt;PRoot Localhost&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color='#F59E0B'&gt;8086&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Auth &amp; Telemetry API&lt;/td&gt;&lt;td&gt;PRoot Localhost&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color='#A855F7'&gt;8080&lt;/font&gt;&lt;/td&gt;&lt;td&gt;FileBrowser Manager&lt;/td&gt;&lt;td&gt;PRoot Localhost&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color='#10B981'&gt;8022&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Termux OpenSSH&lt;/td&gt;&lt;td&gt;LAN (192.168.1.13)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color='#EC4899'&gt;1883&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Mosquitto MQTT&lt;/td&gt;&lt;td&gt;LAN (192.168.1.13)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color='#10B981'&gt;3000/53&lt;/font&gt;&lt;/td&gt;&lt;td&gt;AdGuard Home DNS&lt;/td&gt;&lt;td&gt;PRoot Localhost&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;strokeWidth=1;arcSize=6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="zone_legend">
          <mxGeometry x="20" y="45" width="280" height="215" as="geometry" />
        </mxCell>

        <mxCell id="legend_commands" value="&lt;b&gt;&lt;font color='#10B981' style='font-size: 13px;'&gt;Quick Maintenance Runbook&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 11px;'&gt;&lt;b&gt;1. Enter Debian PRoot:&lt;/b&gt;&lt;br/&gt;&lt;font color='#F8FAFC'&gt;&lt;code&gt;proot-distro login debian&lt;/code&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. GitOps One-Click Deploy:&lt;/b&gt;&lt;br/&gt;&lt;font color='#F8FAFC'&gt;&lt;code&gt;bash /root/tablet-server-infra/scripts/deploy.sh&lt;/code&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. Inspect Process Status:&lt;/b&gt;&lt;br/&gt;&lt;font color='#F8FAFC'&gt;&lt;code&gt;ps aux | grep -E 'run-tunnel|cloudflared|nginx'&lt;/code&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. Live Watchdog Logs:&lt;/b&gt;&lt;br/&gt;&lt;font color='#F8FAFC'&gt;&lt;code&gt;tail -f /var/log/supervisor.log&lt;/code&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;strokeWidth=1;arcSize=6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="zone_legend">
          <mxGeometry x="320" y="45" width="290" height="215" as="geometry" />
        </mxCell>

        <!-- ==================== FLOW CONNECTORS & ARROWS ==================== -->

        <!-- 1. Client to Cloudflare Edge -->
        <mxCell id="edge_client_to_cf" value="&lt;b&gt;HTTPS GET / POST&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;TCP 443 (TLS 1.3)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#38BDF8;strokeWidth=2.5;fontColor=#38BDF8;" edge="1" parent="1" source="client_browser" target="cf_dns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Cloudflare DNS to Tunnel Edge -->
        <mxCell id="edge_cf_dns_to_tunnel" value="&lt;b&gt;Proxied CNAME&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;WAF &amp; DDoS Filtered&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F97316;strokeWidth=2.5;fontColor=#FB923C;" edge="1" parent="1" source="cf_dns" target="cf_tunnel_edge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. Cloudflare Tunnel Edge to cloudflared (HTTP/2 Outbound) -->
        <mxCell id="edge_cf_to_cloudflared" value="&lt;b&gt;OUTBOUND ENCRYPTED TUNNEL&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;Protocol: HTTP/2 (Persistent Mux)&lt;br/&gt;No NAT / Port Forwarding Needed&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=3;dashed=0;fontColor=#FDBA74;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf_tunnel_edge" target="srv_cloudflared">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="378" />
              <mxPoint x="700" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4. Watchdog supervising Cloudflared -->
        <mxCell id="edge_watchdog_to_cf" value="&lt;b&gt;Auto-Restart&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;Respawn in 3s&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontColor=#6EE7B7;dashed=1;" edge="1" parent="1" source="srv_watchdog" target="srv_cloudflared">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. Watchdog supervising Nginx -->
        <mxCell id="edge_watchdog_to_nginx" value="&lt;b&gt;Health Check &amp; Resurrect&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;pgrep -x nginx&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontColor=#6EE7B7;dashed=1;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv_watchdog" target="srv_nginx">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="905" y="360" />
              <mxPoint x="944" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 6. Cloudflared forward to Nginx -->
        <mxCell id="edge_cf_to_nginx" value="&lt;b&gt;Ingress Proxy: http://127.0.0.1:8085&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;Transfers incoming requests to Nginx Gateway&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F97316;strokeWidth=2.5;fontColor=#FED7AA;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv_cloudflared" target="srv_nginx">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1240" y="360" />
              <mxPoint x="1332" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 7. Nginx to Static SPA -->
        <mxCell id="edge_nginx_to_static" value="&lt;b&gt;/ , /about , /login&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;Static Files (HTML/CSS/JS)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#BAE6FD;" edge="1" parent="1" source="srv_nginx" target="app_static_web">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="520" />
              <mxPoint x="860" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. Nginx to Sys Monitor -->
        <mxCell id="edge_nginx_to_api" value="&lt;b&gt;proxy_pass /api/&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;http://127.0.0.1:8086&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2;fontColor=#FDE68A;" edge="1" parent="1" source="srv_nginx" target="app_sys_monitor">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="520" />
              <mxPoint x="1110" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 9. Nginx to FileBrowser -->
        <mxCell id="edge_nginx_to_fb" value="&lt;b&gt;proxy_pass /files/&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;http://127.0.0.1:8080 (WebSockets)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A855F7;strokeWidth=2;fontColor=#E9D5FF;" edge="1" parent="1" source="srv_nginx" target="app_filebrowser">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1360" y="520" />
              <mxPoint x="1360" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 10. Admin LAN to SSH -->
        <mxCell id="edge_admin_to_ssh" value="&lt;b&gt;SSH Port 8022&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;LAN Terminal Management&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontColor=#6EE7B7;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lan_admin_workstation" target="termux_sshd">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="645" />
              <mxPoint x="700" y="888" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 11. Termux Boot triggers Debian PRoot -->
        <mxCell id="edge_boot_to_proot" value="&lt;b&gt;proot-distro login debian&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;Bootstraps services on boot&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0EA5E9;strokeWidth=2;dashed=1;fontColor=#7DD3FC;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="termux_boot" target="zone_debian">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="885" y="800" />
              <mxPoint x="848" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
